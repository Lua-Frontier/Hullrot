<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:changelog="clr-namespace:Content.Client.Changelog"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:lobbyScreen="clr-namespace:Content.Client._Lua.LobbyScreen">

    <!-- Background -->
    <lobbyScreen:LobbyBackgroundControl Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />

    <!-- Main Container -->
    <BoxContainer
        Name="MainContainer"
        VerticalExpand="True"
        HorizontalExpand="True"
        Orientation="Vertical"
        Margin="10 10 10 10">

        <!-- Top Bar with Buttons -->
        <BoxContainer
            Name="TopSide"
            Orientation="Vertical"
            HorizontalExpand="True"
            VerticalAlignment="Top">
            <controls:StripeBack>
                <PanelContainer
                    Name="TopPanel"
                    StyleClasses="AngleRect"
                    HorizontalExpand="True">
                    <BoxContainer
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        Margin="8 8 8 8">
                        <BoxContainer
                            Orientation="Horizontal"
                            MinSize="0 40"
                            HorizontalAlignment="Center">
                            <Button Name="Rules" Text="{Loc 'server-info-rules-button'}" MinSize="125 10"/>
                            <Button Name="Guidebook" Text="{Loc 'server-info-guidebook-button'}" MinSize="125 10"/>
                            <changelog:ChangelogButton Name="Changelog" MinSize="125 10"/>
                            <Button Name="Wiki" Text="{Loc 'server-info-wiki-button'}" MinSize="125 10"/>
                            <vote:VoteCallMenuButton Name="CallVoteButton" MinSize="125 10"/>
                            <controls:VSpacer Spacing="25"/>
                            <TextureRect
                                TextureScale="1 1"
                                Stretch="KeepCentered"
                                TexturePath="/Textures/_Lua/Logo/icon/icon-48x48.png"/>
                            <controls:VSpacer Spacing="25"/>
                            <Button Name="Boosty" Text="Boosty" MinSize="125 10"/>
                            <Button Name="Discord" Text="Discord" MinSize="125 10"/>
                            <Button Name="Telegram" Text="Telegram" MinSize="125 10"/>
                            <Button Name="Site" Text="{Loc 'ui-lobby-site-button'}" MinSize="125 10"/>
                            <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}" MinSize="125 10"/>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
            </controls:StripeBack>
            <BoxContainer
                Orientation="Vertical"
                Name="VoteContainer"
                Access="Public"
                Margin="0 8"/>
        </BoxContainer>

        <!-- Main Content Area -->
        <BoxContainer
            Orientation="Horizontal"
            HorizontalExpand="True"
            VerticalExpand="True">

            <!-- Left Side Content -->
            <BoxContainer
                Name="LeftSide"
                Orientation="Vertical"
                HorizontalExpand="True"
                VerticalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Name="TopLeft" Orientation="Vertical">
                        <PanelContainer Margin="0 0 0 8" MinHeight="40" Visible="False" Name="PlaytimeCommentContainer" Access="Public" HorizontalAlignment="Left">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#44222288" BorderColor="#88222288" BorderThickness="2" />
                            </PanelContainer.PanelOverride>
                            <RichTextLabel Name="PlaytimeComment" Access="Public" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8 8 8 8" />
                        </PanelContainer>
                        <!-- Center Panel -->
                        <PanelContainer
                            Name="CenterPanel"
                            HorizontalAlignment="Left"
                            VerticalExpand="True"
                            VerticalAlignment="Top"
                            Access="Public">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#15151588" />
                            </PanelContainer.PanelOverride>
                            <GridContainer Rows="4" Columns="1">
                                <!-- Game Title -->
                                <PanelContainer Margin="12 12 12 12">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BackgroundColor="#152b56FF" />
                                    </PanelContainer.PanelOverride>
                                    <Label
                                        Name="GameName"
                                        Margin="4 4 4 4"
                                        StyleClasses="LabelSmall"
                                        VAlign="Center"
                                        HorizontalAlignment="Center"
                                        Text="Пандора"
                                        FontColorOverride="{x:Static maths:Color.White}"/>
                                </PanelContainer>
                                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
                                <controls:HSpacer Spacing="5" />
                                <!-- Buttons -->
                                <GridContainer Columns="1">
                                    <Label Name="StartTime"
                                           Access="Public"
                                           Align="Left"
                                           FontColorOverride="{x:Static maths:Color.DarkGray}"
                                           StyleClasses="LabelKeyText"
                                           HorizontalExpand="True"
                                           Margin="8 0 0 0"/>
                                    <Button Name="ReadyButton"
                                            Access="Public"
                                            ToggleMode="True"
                                            Text="{Loc 'ui-lobby-ready-up-button'}"
                                            StyleClasses="ButtonBig"
                                            MinWidth="137"
                                            Margin="8 16 8 0"/>
                                    <cc:UICommandButton
                                            Command="observe"
                                            Name="ObserveButton"
                                            Access="Public"
                                            Text="{Loc 'ui-lobby-observe-button'}"
                                            StyleClasses="ButtonBig"
                                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}"
                                            Margin="8 0 8 0"/>
                                    <Button Name="ManifestButton" Access="Public"
                                            Text="Manifest"
                                            StyleClasses="ButtonBig"
                                            Margin="8 0 8 0"/>
                                    <Button Name="OptionsButton"
                                            Access="Public"
                                            StyleClasses="ButtonBig"
                                            Text="{Loc 'ui-lobby-options-button'}"
                                            Margin="8 0 8 0"/>
                                    <Button Name="LeaveButton"
                                            Access="Public"
                                            StyleClasses="ButtonBig"
                                            Text="{Loc 'ui-lobby-leave-button'}"
                                            Margin="8 0 8 12"/>
                                </GridContainer>
                            </GridContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <!-- Left Bot Panel -->
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" SeparationOverride="4">
                        <Button Name="MinimizeButton" Access="Public" ToggleMode="True" Text="{Loc 'ui-lobby-minimize-button'}" />
                        <controls:VSpacer Spacing="10" />
                        <!-- Music Control Buttons -->
                        <Button Name="PreviousTrackButton" Access="Public" Text="{Loc 'ui-lobby-previous-track'}" MinSize="40 32" />
                        <Button Name="StopTrackButton" Access="Public" ToggleMode="True" Text="{Loc 'ui-lobby-stop-track'}" MinSize="40 32" />
                        <Button Name="NextTrackButton" Access="Public" Text="{Loc 'ui-lobby-next-track'}" MinSize="40 32" />
                        <controls:VSpacer Spacing="20" />
                        <!-- Background Control Buttons -->
                        <Button Name="PreviousBackgroundButton" Access="Public" Text="{Loc 'ui-lobby-background-prev'}" MinSize="32 32" />
                        <Label Text="{Loc 'ui-lobby-background-label'}" VAlign="Center" Margin="6 0 6 0" />
                        <Button Name="NextBackgroundButton" Access="Public" Text="{Loc 'ui-lobby-background-next'}" MinSize="32 32" />
                    </BoxContainer>
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>

            <!-- Right Side (Chat) -->
            <PanelContainer
                Name="RightSide"
                StyleClasses="AngleRect"
                HorizontalAlignment="Right"
                VerticalExpand="True"
                VerticalAlignment="Stretch"
                Access="Public">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#76428A88" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <!-- Server Info -->
                    <BoxContainer Orientation="Horizontal" MinSize="0 40" Name="HeaderContainer" Access="Public"
                                  SeparationOverride="4">
                        <Label Margin="8 0 0 0" StyleClasses="LabelHeadingBigger" VAlign="Center"
                               Text="{Loc 'ui-lobby-title'}" />
                        <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger" VAlign="Center"
                               HorizontalExpand="True" HorizontalAlignment="Center" />
                    </BoxContainer>
                    <controls:HLine Color="{x:Static maths:Color.White}" Thickness="2" />
                    <controls:HSpacer Spacing="10" />
                    <controls:NanoHeading Text="{Loc 'ui-lobby-server-info-block'}" />
                    <Label Name="StationTime" Access="Public" FontColorOverride="{x:Static maths:Color.White}"
                           Margin="3 3 3 3" HorizontalAlignment="Left" />
                    <controls:HSpacer Spacing="5" />
                    <BoxContainer MinHeight="10" />
                    <controls:HLine Color="{x:Static maths:Color.White}" Thickness="2" Access="Public" />
                    <controls:HSpacer Spacing="10" />
                    <!-- Chat Box -->
                    <widgets:ChatBox
                        Name="Chat"
                        Access="Public"
                        VerticalExpand="True"
                        Margin="3 3 3 3"
                        MinHeight="50" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
